{
  "name": "atlas-desktop-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Atlas Code desktop cockpit · Tauri/React operational surface for the Atlas Engineering Operations System.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@atlas/desktop",
    "build": "npm run build --workspace=@atlas/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "atlas-frontend:test": "npm run atlas-frontend:test --workspace=@atlas/desktop",
    "atlas-ai:test": "npm run atlas-ai:test --workspace=@atlas/desktop",
    "atlas-dev:test": "npm run atlas-dev:test --workspace=@atlas/desktop",
    "atlas-dev:certify": "npm run atlas-dev:test && npm run visual-smoke --workspace=@atlas/desktop && npm run build --workspace=@atlas/desktop",
    "tauri": "npm run tauri --workspace=@atlas/desktop",
    "tauri:dev": "npm run tauri:dev --workspace=@atlas/desktop",
    "tauri:build": "npm run tauri:build --workspace=@atlas/desktop"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1"
  }
}
