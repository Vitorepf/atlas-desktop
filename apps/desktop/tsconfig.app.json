{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@atlas/domain": ["../../packages/atlas-domain/src/index.ts"],
      "@atlas/ui": ["../../packages/atlas-ui/src/index.ts"],
      "@atlas/ui/*": ["../../packages/atlas-ui/src/*"],
      "@atlas/rich-input-canon": ["../../../packages/atlas-rich-input-canon/src/index.ts"]
    }
  },
  "include": ["src"]
}
